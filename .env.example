# Server Configuration
PORT=5000
NODE_ENV=development

# Python Path Override (Use 'python3' for Linux/Docker, or 'py -3.12' on Windows)
PYTHON_PATH=

# Optional AI LLM API Keys (For enhanced semantic prompt matching)
# If left blank, the built-in heuristic NLP scoring engine is used automatically with 0 cost.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Client Base URL (Only needed if client is deployed separately from server)
# VITE_API_URL=https://your-backend-app.onrender.com
